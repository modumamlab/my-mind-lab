// ============================================
// 설정 읽기
// ============================================

export function collectSettingsForm() {

    return {

        clinicName:
            document.querySelector("#clinicName")?.value || "",

        counselorName:
            document.querySelector("#counselorName")?.value || "",

        aiEnabled:
            document.querySelector("#aiEnabled")?.checked,

        aiModel:
            document.querySelector("#aiModel")?.value,

        aiTemperature:
            Number(
                document.querySelector("#aiTemperature")?.value
            ),

        aiMaxTokens:
            Number(
                document.querySelector("#aiMaxTokens")?.value
            ),

        counselingMinutes:
            Number(
                document.querySelector("#counselingMinutes")?.value
            ),

        reminderMinutes:
            Number(
                document.querySelector("#reminderMinutes")?.value
            ),

        autoSave:
            document.querySelector("#autoSave")?.checked,

        reportApproval:
            document.querySelector("#reportApproval")?.checked,

        pdfPageSize:
            document.querySelector("#pdfPageSize")?.value,

        theme:
            document.querySelector("#theme")?.value

    };

}