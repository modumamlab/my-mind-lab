// ============================================
// Settings Render
// 환경설정 화면
// ============================================

function escapeHtml(value = "") {
    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
}

// ============================================
// 체크박스
// ============================================

function checked(value) {
    return value ? "checked" : "";
}

// ============================================
// 선택값
// ============================================

function selected(value, target) {
    return value === target ? "selected" : "";
}

// ============================================
// 환경설정 폼
// ============================================

