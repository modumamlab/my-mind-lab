// ============================================
// TODAY 저장소
// ============================================

import {
    loadJson,
    saveJson
} from "../core/storage.js";

import {
    STORAGE_KEYS
} from "../core/constants.js";

// ============================================
// 오늘 업무
// ============================================

export function getTodayTasks() {

    return loadJson(
        STORAGE_KEYS.todayTasks,
        []
    );

}

export function saveTodayTasks(tasks) {

    saveJson(
        STORAGE_KEYS.todayTasks,
        tasks
    );

}

// ============================================
// 오늘 상담
// ============================================

export function getTodayCounselings() {

