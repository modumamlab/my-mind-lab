// ============================================
// TODAY 화면 렌더링
// ============================================

function escapeHtml(value = "") {
    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
}

// ============================================
// 우선순위 배지
// ============================================

function priorityBadge(priority) {

    const config = {
        high: {
            text: "높음",
            className: "badge-danger"
        },
        normal: {
            text: "보통",
            className: "badge-primary"
        },
        low: {
            text: "낮음",
            className: "badge-secondary"
        }
    };

    const badge =
        config[priority] ||
        config.normal;

    return `
        <span class="${badge.className}">
            ${badge.text}
        </span>
    `;

}

// ============================================
// TODAY 업무 카드
// ============================================

export function createTaskCard(task) {

    return `

<div class="today-task-card">

    <div class="today-task-header">

        ${priorityBadge(task.priority)}

        <h4>

            ${escapeHtml(task.title)}

        </h4>

    </div>

    <div class="today-task-body">

        ${escapeHtml(task.description)}

    </div>

    <div class="today-task-footer">

        <button
            data-action="today-task-complete"
            data-id="${task.id}"
        >

            완료

        </button>

        <button
            data-action="${task.action}"
            data-id="${task.reservationId}"

        >

            바로가기

        </button>

    </div>

</div>

`;

}

// ============================================
// 오늘 예약 카드
// ============================================

export function createTodayReservationCard(item) {

    return `

<div class="today-reservation-card">

    <div class="today-time">

        ${escapeHtml(item.time)}

    </div>

    <div class="today-client">

        <strong>

            ${escapeHtml(item.name || item.clientName)}

        </strong>

    </div>

    <div>

        ${escapeHtml(item.program)}

    </div>

    <div>

        ${escapeHtml(item.method)}

    </div>

    <button

        data-action="open-reservation"

        data-id="${item.id}"

    >

        예약보기

    </button>

</div>

`;

}

