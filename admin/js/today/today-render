// ============================================
// 업무목록
// ============================================

export function renderTodayTasks(
    tasks,
    container
) {

    if (!container) {

        return;

    }

    if (!tasks.length) {

        container.innerHTML = `

<div class="empty-state">

오늘 해야 할 업무가 없습니다.

</div>

`;

        return;

    }

    container.innerHTML =
        tasks
            .map(createTaskCard)
            .join("");

}

