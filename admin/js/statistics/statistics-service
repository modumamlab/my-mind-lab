// ============================================
// TODAY KPI
// ============================================

export function buildTodayStatistics() {

    const dashboard =
        buildDashboardData();

    return {

        cards: [

            {

                title:
                    "예약",

                value:
                    dashboard.reservations

            },

            {

                title:
                    "상담",

                value:
                    dashboard.counseling

            },

            {

                title:
                    "검사",

                value:
                    dashboard.assessments

            },

            {

                title:
                    "내담자",

                value:
                    dashboard.clients

            }

        ]

    };

}

// ============================================
// Dashboard KPI
// ============================================

export function buildDashboardStatistics() {

    return {

        dashboard:
            buildDashboardData(),

        reservation:
            calculateReservationRate(),

        counseling:
            calculateCounselingRate(),

        report:
            calculateReportRate(),

        aiUsage:
            calculateAiUsageRate()

    };

}

// ============================================
// 월별 성장률
// ============================================

export function calculateMonthlyGrowth() {

    const {

        monthlyReservations

    } = buildDashboardData();

    const months =
        Object.keys(
            monthlyReservations
        ).sort();

    return months.map((month, index) => {

        const current =
            monthlyReservations[
                month
            ];

        const previous =
            index === 0
                ? current
                : monthlyReservations[
                    months[index - 1]
                ];

        return {

            month,

            value:
                current,

            growth:
                percent(
                    current - previous,
                    previous || 1
                )

        };

    });

}

// ============================================
// 전체 통계
// ============================================

export function buildStatistics() {

    return {

        today:
            buildTodayStatistics(),

        dashboard:
            buildDashboardStatistics(),

        monthlyGrowth:
            calculateMonthlyGrowth()

    };

}