// ============================================
// Statistics Service
// 통계 계산
// ============================================

import {
    getStatisticsSource,
    buildDashboardData
} from "./statistics-store.js";

// ============================================
// 퍼센트 계산
// ============================================

function percent(part = 0, total = 0) {

    if (!total) return 0;

    return Math.round(
        (part / total) * 100
    );

}

// ============================================
// 예약 승인율
// ============================================

export function calculateReservationRate() {

    const {
        reservations
    } = getStatisticsSource();

    const approved =
        reservations.filter(item =>
            item.status === "예약확정"
        ).length;

    return {

        total:
            reservations.length,

        approved,

        rate:
            percent(
                approved,
                reservations.length
            )

    };

}

