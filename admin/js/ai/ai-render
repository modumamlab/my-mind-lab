// ============================================
// AI 결과 화면 렌더링
// ============================================

function escapeHtml(value = "") {
    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
}

function renderText(value = "") {
    const text =
        String(value || "").trim();

    if (!text) {
        return `
            <div class="empty-state">
                생성된 내용이 없습니다.
            </div>
        `;
    }

    return escapeHtml(text)
        .replace(/\n/g, "<br>");
}

