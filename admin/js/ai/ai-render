// ============================================
// AI 품질검사 결과
// ============================================

export function renderQualityResult(
    quality = {},
    container
) {
    if (!container) {
        return;
    }

    const issues =
        Array.isArray(quality.issues)
            ? quality.issues
            : [];

    container.innerHTML = `
        <div class="ai-quality-card">

            <h3>AI 품질검사</h3>

            <div>
                <strong>검사결과</strong>
                ${escapeHtml(
                    quality.passed === false
                        ? "수정 필요"
                        : "확인 완료"
                )}
            </div>

            ${
                issues.length
                    ? `
                        <ul>
                            ${issues
                                .map(
                                    issue => `
                                        <li>
                                            ${escapeHtml(issue)}
                                        </li>
                                    `
                                )
                                .join("")}
                        </ul>
                    `
                    : `
                        <div class="empty-state">
                            확인된 문제점이 없습니다.
                        </div>
                    `
            }

        </div>
    `;
}