// ============================================
// Prompt 조회
// ============================================

export function getPrompt(name) {

    return PROMPTS[name] || "";

}

// ============================================
// Prompt 존재 여부
// ============================================

export function hasPrompt(name) {

    return Boolean(
        PROMPTS[name]
    );

}

// ============================================
// Prompt 목록
// ============================================

export function listPrompts() {

    return Object.keys(
        PROMPTS
    );

}