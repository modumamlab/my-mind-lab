// ============================================
// 전자차트 카드
// ============================================

export function createChartCard(chart) {

    return `

<div class="chart-card">

    <div class="chart-header">

        <h3>

            ${escapeHtml(chart.clientName)}

        </h3>

        <div>

            ${escapeHtml(chart.program)}

        </div>

    </div>

    <div class="chart-section">

        <h4>심리검사</h4>

        ${renderTests(chart)}

    </div>

    <div class="chart-section">

        <h4>검사결과</h4>

        ${renderAssessmentResults(chart)}

    </div>

    <div class="chart-section">

        <h4>보고서</h4>

        ${renderReports(chart)}

    </div>

    <div class="chart-section">

        <h4>상담기록</h4>

        ${renderCounseling(chart)}

    </div>

    <div class="chart-section">

        <h4>AI 상담</h4>

        ${renderAiCounseling(chart)}

    </div>

    <div class="chart-footer">

        <button
            data-action="open-chart"
            data-id="${chart.id}"
        >
            열기
        </button>

        <button
            data-action="edit-chart"
            data-id="${chart.id}"
        >
            수정
        </button>

    </div>

</div>

`;

}

// ============================================
// 차트목록
// ============================================

export function renderChartList(
    charts = [],
    container
) {

    if (!container) {

        return;

    }

    if (!charts.length) {

        container.innerHTML = `

<div class="chart-empty">

전자차트가 없습니다.

</div>

`;

        return;

    }

    container.innerHTML = charts
        .map(createChartCard)
        .join("");

}