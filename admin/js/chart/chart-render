// ============================================
// 전자차트 렌더링
// ============================================

function escapeHtml(value = "") {
    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
}

// ============================================
// 검사목록
// ============================================

export function renderTests(chart) {

    if (!chart.tests?.length) {

        return "<span>-</span>";

    }

    return chart.tests
        .map(test => `
            <span class="chart-chip">
                ${escapeHtml(test)}
            </span>
        `)
        .join("");

}

// ============================================
// 검사결과 목록
// ============================================

export function renderAssessmentResults(chart) {

    if (!chart.assessmentResults?.length) {

        return `
            <div class="chart-empty">

                업로드된 검사결과가 없습니다.

            </div>
        `;

    }

    return chart.assessmentResults
        .map(result => `

<div class="chart-item">

    <strong>

        ${escapeHtml(result.testName)}

    </strong>

    <div>

        ${escapeHtml(result.summary || "")}

    </div>

</div>

`)
        .join("");

}

