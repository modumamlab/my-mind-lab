// ============================================
// 예약정보 갱신
// ============================================

export function updateReservationInfo(
    chartId,
    reservation
) {

    return updateChart(chartId, {

        reservation:
            deepCopy(reservation),

        tests:
            Array.isArray(
                reservation.tests
            )
                ? [...reservation.tests]
                : []

    });

}

// ============================================
// 차트 삭제
// ============================================

export function deleteChart(
    chartId
) {

    const chart =
        getChart(chartId);

    if (!chart) {

        return {

            success: false,

            message:
                "전자차트를 찾을 수 없습니다."

        };

    }

    removeChart(chartId);

    return {

        success: true,

        chart

    };

}

// ============================================
// 통계
// ============================================

export function getChartSummary() {

    const charts =
        getCharts();

    return {

        total:
            charts.length,

        assessmentResults:
            charts.reduce(
                (sum, chart) =>
                    sum +
                    (
                        chart
                            .assessmentResults
                            ?.length || 0
                    ),
                0
            ),

        reports:
            charts.reduce(
                (sum, chart) =>
                    sum +
                    (
                        chart
                            .reports
                            ?.length || 0
                    ),
                0
            ),

        counselingRecords:
            charts.reduce(
                (sum, chart) =>
                    sum +
                    (
                        chart
                            .counselingRecords
                            ?.length || 0
                    ),
                0
            ),

        aiCounseling:
            charts.reduce(
                (sum, chart) =>
                    sum +
                    (
                        chart
                            .aiCounseling
                            ?.length || 0
                    ),
                0
            )

    };

}