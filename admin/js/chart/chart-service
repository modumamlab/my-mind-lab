// ============================================
// 전자차트 서비스
// ============================================

import {
    getCharts,
    getChart,
    getChartByReservation,
    addChart,
    updateChart,
    removeChart
} from "./chart-store.js";

import {
    uuid,
    deepCopy
} from "../core/utils.js";

// ============================================
// 전자차트 생성
// ============================================

export function createChart(reservation = {}) {

    const exists =
        getChartByReservation(
            reservation.id
        );

    if (exists) {

        return exists;

    }

    const now =
        new Date().toISOString();

    const chart = {

        id: uuid(),

        reservationId:
            reservation.id,

        clientId:
            reservation.clientId || "",

        clientName:
            reservation.name || "",

        phone:
            reservation.phone || "",

        program:
            reservation.program || "",

        tests:
            Array.isArray(
                reservation.tests
            )
                ? [...reservation.tests]
                : [],

        reservation,

        assessmentResults: [],

        reports: [],

        counselingRecords: [],

        aiCounseling: [],

        createdAt: now,

        updatedAt: now

    };

    addChart(chart);

    return chart;

}

// ============================================
// 검사결과 추가
// ============================================

export function addAssessmentResult(
    chartId,
    result
) {

    const chart =
        getChart(chartId);

    if (!chart) {

        return false;

    }

    const list =
        Array.isArray(
            chart.assessmentResults
        )
            ? [...chart.assessmentResults]
            : [];

    list.push(
        deepCopy(result)
    );

    return updateChart(chartId, {

        assessmentResults: list

    });

}

// ============================================
// 보고서 연결
// ============================================

export function addReportToChart(
    chartId,
    report
) {

    const chart =
        getChart(chartId);

    if (!chart) {

        return false;

    }

    const reports =
        Array.isArray(chart.reports)
            ? [...chart.reports]
            : [];

    reports.push(
        deepCopy(report)
    );

    return updateChart(chartId, {

        reports

    });

}

